APP_ENVIRONMENT=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=semanticsearch
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/semanticsearch
UPLOAD_DIRECTORY=/app/uploads
OLLAMA_BASE_URL=http://ollama:11434
GROQ_API_KEY=
OLLAMA_PORT=11434
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api

# Keycloak Configuration
KEYCLOAK_BASE_URL=http://localhost:9090
KEYCLOAK_REALM=semanticsearch
KEYCLOAK_CLIENT_ID=semanticsearch-web
KEYCLOAK_AUDIENCE=semanticsearch-web
KEYCLOAK_JWKS_TIMEOUT_SEC=5
KEYCLOAK_JWKS_VERIFY_ENABLED=false
KEYCLOAK_REFRESH_EXCHANGE_ENABLED=false
KEYCLOAK_REDIRECT_URI=http://localhost:5173/login/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
KEYCLOAK_SCOPE=openid profile email
KEYCLOAK_REDIRECT_URI_FALLBACK=http://localhost:5173/login/callback

# Session Configuration
SESSION_COOKIE_NAME=semanticsearch_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=604800

# Admin credentials (for development only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
