                <mxCell id="doc-svc-fe" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" value="documentService.ts (Frontend Service)&#xa;───────────────────────&#xa;Functions:&#xa;  getDocuments() → GET /documents&#xa;  uploadDocument(file, visibility) → POST /documents&#xa;  deleteDocument(id) → DELETE /documents/:id&#xa;  updateDocumentVisibility(id, vis) → PATCH /documents/:id/visibility&#xa;Uses apiRequest with credentials: &#39;include&#39;" vertex="1">
                    <mxGeometry height="200" width="400" x="900" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="doc-api-fe" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" value="documentApi.ts (API Layer)&#xa;───────────────────────&#xa;Maps API Response → Document Type&#xa;mapDocument(): API → Document&#xa;FormData for uploads&#xa;JSON for PATCH/DELETE&#xa;Error parsing with friendly messages" vertex="1">
                    <mxGeometry height="180" width="400" x="900" y="680" as="geometry"/>
