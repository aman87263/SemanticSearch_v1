        </mxCell>



        

        <mxCell id="use-auth" value="useAuth Hook (useAuth.ts)&#10;────────────────────────&#10;Returns: { isAuthenticated }&#10;Sync via useSyncExternalStore&#10;Subscribes to auth-changed events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;fontSize=11;fontColor=#C2185B;" vertex="1" parent="layer-fe">

