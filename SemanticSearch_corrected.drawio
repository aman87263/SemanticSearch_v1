        <mxCell id="use-current-user" value="useCurrentUser Hook (useCurrentUser.ts)&#10;────────────────────────&#10;Returns: UserInfo | null&#10;Calls /auth/me on auth change&#10;Auto-clears on logout&#10;Fields: user_id, roles, email, name,&#10;  preferred_username, provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;fontSize=11;fontColor=#C2185B;" vertex="1" parent="layer-fe">

