                <mxCell id="auth-ctx" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;fontSize=11;fontColor=#C2185B;" value="AuthContext (AuthContext.tsx)&#xa;────────────────────────&#xa;State:&#xa;  isAuthenticated: boolean&#xa;  (synced via auth-changed events)&#xa;Functions:&#xa;  restoreSession() → /auth/refresh&#xa;  notifyAuthChanged()&#xa;Events:&#xa;  auth-changed (window event)&#xa;  storage (cross-tab sync)&#xa;Session Management:&#xa;  HttpOnly Cookie (semanticsearch_session)&#xa;  In-memory Access Token (JWT)&#xa;  Keycloak PKCE Flow" vertex="1">
                    <mxGeometry height="220" width="450" x="100" y="680" as="geometry"/>
