                <mxCell id="routing" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#9C27B0;fontSize=11;fontColor=#7B1FA2;" value="APP ROUTING (react-router-dom v6)&#xa;BrowserRouter&#xa;Routes:&#xa;  /login → LoginPage&#xa;  /login/callback → LoginCallbackPage&#xa;  /chat → ChatPage (Protected)&#xa;  /documents → DocumentsPage (Protected)&#xa;  /search → SearchPage (Protected)&#xa;  /settings → SettingsPage (Protected)&#xa;  \* → Redirect to /chat&#xa;ProtectedRoute wrapper with AuthContext" vertex="1">
                    <mxGeometry height="200" width="450" x="100" y="450" as="geometry"/>
