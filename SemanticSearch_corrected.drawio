                <mxCell id="docker-net" parent="layer-ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#6C757D;fontSize=11;fontColor=#495057;dashed=1;" value="DOCKER NETWORK (semanticsearch_default)&#xa;Service Discovery via DNS&#xa;Internal Ports:&#xa;  - backend: 8000&#xa;  - frontend: 5173&#xa;  - keycloak: 8080&#xa;  - postgres: 5432" vertex="1">
