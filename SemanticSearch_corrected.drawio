        </mxCell>



        <mxCell id="auth-ctx" value="AuthContext (AuthContext.tsx)&#10;────────────────────────&#10;State:&#10;  isAuthenticated: boolean&#10;  (synced via auth-changed events)&#10;Functions:&#10;  restoreSession() → /auth/refresh&#10;  notifyAuthChanged()&#10;Events:&#10;  auth-changed (window event)&#10;  storage (cross-tab sync)&#10;Session Management:&#10;  HttpOnly Cookie (semanticsearch_session)&#10;  In-memory Access Token (JWT)&#10;  Keycloak PKCE Flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#E91E63;fontSize=11;fontColor=#C2185B;" vertex="1" parent="layer-fe">

