        <mxCell id="http-client" value="apiRequest / httpClient.ts&#10;───────────────────────&#10;Base URL: /api (proxied by Vite)&#10;credentials: 'include' (cookies)&#10;Headers: Origin, Referer, Content-Type&#10;Auto JSON parsing&#10;Error handling &amp; parsing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">

