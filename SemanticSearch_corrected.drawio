        <mxCell id="doc-svc-fe" value="documentService.ts (Frontend Service)&#10;───────────────────────&#10;Functions:&#10;  getDocuments() → GET /documents&#10;  uploadDocument(file, visibility) → POST /documents&#10;  deleteDocument(id) → DELETE /documents/:id&#10;  updateDocumentVisibility(id, vis) → PATCH /documents/:id/visibility&#10;Uses apiRequest with credentials: 'include'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">

