                <mxCell id="use-auth" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;fontSize=11;fontColor=#C2185B;" value="useAuth Hook (useAuth.ts)&#xa;────────────────────────&#xa;Returns: { isAuthenticated }&#xa;Sync via useSyncExternalStore&#xa;Subscribes to auth-changed events" vertex="1">
                    <mxGeometry height="120" width="300" x="580" y="680" as="geometry"/>
                </mxCell>
                <mxCell id="use-current-user" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#E91E63;fontSize=11;fontColor=#C2185B;" value="useCurrentUser Hook (useCurrentUser.ts)&#xa;────────────────────────&#xa;Returns: UserInfo | null&#xa;Calls /auth/me on auth change&#xa;Auto-clears on logout&#xa;Fields: user_id, roles, email, name,&#xa;  preferred_username, provider" vertex="1">
                    <mxGeometry height="140" width="300" x="580" y="820" as="geometry"/>
