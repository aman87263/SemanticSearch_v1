        <mxCell id="postgres" value="POSTGRESQL 16 + PGVECTOR&#10;Port 5432&#10;Database: semanticsearch&#10;Tables:&#10;  - documents (id, name, owner_id, visibility, ...)&#10;  - document_chunks (embedding vector(384))&#10;  - Keycloak tables (realm, users, roles)&#10;Extensions: vector, uuid-ossp&#10;HNSW Index on embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6D8DB;strokeColor=#336791;fontSize=12;fontColor=#1B3A5C;" vertex="1" parent="layer-ext">

