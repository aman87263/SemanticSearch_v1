        <mxCell id="main-app" value="main.py (FastAPI App)&#10;───────────────────────&#10;Middleware Stack:&#10;  1. CORSMiddleware&#10;  2. SessionValidationMiddleware&#10;  3. CSRFProtectionMiddleware&#10;Routers:&#10;  /api/auth → Auth Router&#10;  /api/documents → Document Router&#10;  /api/chat → Chat Router&#10;  /api/search → Search Router&#10;  /api/health → Health Check&#10;Debug: debugpy on Port 5678" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="100" y="1300" width="500" height="220" as="geometry" />

        </mxCell>

        



        <mxCell id="middleware" value="MIDDLEWARE STACK&#10;───────────────────────&#10;1. SessionValidationMiddleware&#10;   - Skip: /auth/\*, /api/health, /api/auth/refresh&#10;   - Reads HttpOnly Cookie (semanticsearch_session)&#10;   - Validates session in SESSION_STORE&#10;   - Attaches session to request.state&#10;2. CSRFProtectionMiddleware&#10;   - POST/PUT/PATCH/DELETE&#10;   - Validates Origin/Referer headers&#10;   - Allowed: localhost:5173, localhost:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="100" y="1550" width="500" height="200" as="geometry" />

        </mxCell>

        <mxCell id="vite-proxy" value="VITE DEV PROXY (vite.config.ts)&#10;───────────────────────&#10;/api → http\://localhost:8000&#10;changeOrigin: true&#10;Same-Origin for Cookies&#10;HMR on Port 5173" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#AB47BC;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">

          <mxGeometry x="1350" y="450" width="350" height="140" as="geometry" />

        </mxCell>



        <mxCell id="auth-router" value="Auth Router (auth.py)&#10;───────────────────────&#10;POST /api/auth/session&#10;   - Dev: Creates session from code/verifier&#10;   - Prod: Exchanges code with Keycloak&#10;   - Stores refresh_token in SESSION_STORE&#10;   - Sets HttpOnly Cookie + returns access_token&#10;POST /api/auth/refresh&#10;   - Uses Cookie to find session&#10;   - Exchanges refresh_token with Keycloak&#10;   - Returns new access_token&#10;   - Mutex lock per session_id (prevents race)&#10;POST /api/auth/logout&#10;   - Revokes session, deletes cookie&#10;GET /api/auth/me&#10;   - Returns user info from JWT&#10;GET /api/auth/keycloak/config&#10;   - Returns Keycloak client config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="650" y="1300" width="450" height="280" as="geometry" />

        </mxCell>





        <mxCell id="doc-router" value="Document Router (document.py)&#10;───────────────────────&#10;GET /api/documents&#10;   - Returns user's docs + public docs&#10;GET /api/documents/public&#10;   - Returns all PUBLIC docs (no auth)&#10;POST /api/documents&#10;   - Upload with visibility (PRIVATE/PUBLIC)&#10;   - FormData: file + visibility&#10;PATCH /api/documents/{id}/visibility&#10;   - Toggle PRIVATE ↔ PUBLIC (owner/admin)&#10;DELETE /api/documents/{id}&#10;   - Owner or Admin only (403 if not)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="650" y="1600" width="450" height="280" as="geometry" />

        </mxCell>

        



        <mxCell id="chat-router" value="Chat &amp; Search Routers&#10;───────────────────────&#10;POST /api/chat&#10;   - QuestionRequest {query, limit, doc_id}&#10;   - Optional auth (get_current_user_optional)&#10;   - Filters: owner_id + PUBLIC docs&#10;POST /api/search&#10;   - SearchRequest {query, limit, doc_id}&#10;   - Vector similarity search&#10;   - Filters by visibility + ownership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="1150" y="1300" width="450" height="200" as="geometry" />

        </mxCell>

        <mxCell id="ui-components" value="UI COMPONENTS (MUI v5)&#10;───────────────────────&#10;Layout:&#10;  Sidebar (Auth, Navigation, User Info)&#10;  MainLayout (Header + Content)&#10;Pages:&#10;  LoginPage / LoginCallbackPage&#10;  ChatPage (ChatInterface + Citations)&#10;  DocumentsPage (UploadZone + DocumentTable)&#10;  SearchPage / SettingsPage&#10;Components:&#10;  UploadZone (Drag&amp;Drop, Visibility Toggle)&#10;  DocumentTable + DocumentRow (Visibility Badge)&#10;  StatusChip, DocumentRow, CitationChip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#9C27B0;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">



<mxGeometry x="1350" y="620" width="450" height="300" as="geometry" />

        </mxCell>

        <mxCell id="auth-deps" value="Auth Dependencies (dependencies/auth.py)&#10;───────────────────────&#10;get_current_user() → CurrentUser&#10;   - Extracts Bearer token&#10;   - Validates JWT via Keycloak JWKS&#10;   - Returns CurrentUser (user_id, roles, email, etc.)&#10;get_current_user_optional() → CurrentUser | None&#10;   - Returns unauthenticated user if no token&#10;require_authenticated_user() → CurrentUser&#10;   - Raises 401 if not authenticated&#10;require_admin() → CurrentUser&#10;   - Raises 403 if not ADMIN role&#10;get_session_from_cookie() → Session&#10;   - Reads HttpOnly Cookie&#10;   - Validates against SESSION_STORE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="1150" y="1520" width="450" height="240" as="geometry" />

        </mxCell>



        <mxCell id="session-store" value="SESSION_STORE (In-Memory Dict)&#10;──────────────────────&#10;Key: session_id (UUID)&#10;Value: Session{&#10;  user_id, roles, provider,&#10;  refresh_token, created_at,&#10;  revoked: bool&#10;}&#10;Mutex: \_refresh_locks dict per session&#10;⚠️ Dev only - Use Redis in Production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=11;fontColor=#E65100;" vertex="1" parent="layer-be">

          <mxGeometry x="1650" y="1300" width="400" height="200" as="geometry" />

        </mxCell>



        <mxCell id="doc-svc-be" value="DocumentService (document_service.py)&#10;────────────────────────&#10;upload_document()&#10;   - Validate file (ext, size)&#10;   - Hash (SHA256) + Duplicate Check (per-user)&#10;   - Store file → Create Document Entity&#10;   - Processing Pipeline → Chunk + Embed&#10;   - Upsert to Vector Store&#10;get_documents(user_id, is_admin)&#10;   - Admin: all docs&#10;   - User: own + public&#10;   - Anonymous: public only&#10;update_document_visibility()&#10;   - Owner/Admin only&#10;delete_document()&#10;   - Delete file + chunks + vector embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="650" y="1900" width="450" height="300" as="geometry" />

        </mxCell>

        



        <mxCell id="pipeline" value="DocumentProcessingPipeline&#10;───────────────────────&#10;1. Text Extraction (PyMuPDF, python-docx)&#10;2. Chunking (RecursiveChunker)&#10;   - chunk_size=1000, overlap=200&#10;3. Embedding (SentenceTransformers)&#10;   - all-MiniLM-L6-v2 (384 dim)&#10;4. Vector Store Upsert (pgvector)&#10;Status Tracking: UPLOADING→PROCESSING→COMPLETED/FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="1150" y="1800" width="450" height="200" as="geometry" />

        </mxCell>

        <mxCell id="doc-ctx" value="DocumentContext (DocumentContext.tsx)&#10;────────────────────────&#10;State:&#10;  documents: Document[]&#10;  loading: boolean&#10;Functions:&#10;  uploadDocument(file, visibility)&#10;  deleteDocument(id)&#10;  updateDocumentVisibility(id, vis)&#10;  refreshDocuments()&#10;Auto-refresh on auth change&#10;Optimistic Updates for all mutations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">

          <mxGeometry x="100" y="920" width="450" height="200" as="geometry" />

        </mxCell>





        <mxCell id="vector-store" value="Vector Store (pgvector via PgVectorStore)&#10;───────────────────────&#10;Interface: IVectorStore&#10;upsert(chunks) → INSERT ON CONFLICT&#10;search(query_vector, limit, filters)&#10;   - HNSW Index (cosine similarity)&#10;   - Filters: document_id, user_id, is_admin&#10;   - PUBLIC docs visible to all&#10;   - Private docs: owner_id filter&#10;Table: document_chunks (embedding vector(384))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="layer-be">

          <mxGeometry x="1150" y="2020" width="450" height="220" as="geometry" />

        </mxCell>

        



        <mxCell id="repos" value="REPOSITORY LAYER (IDocumentRepository)&#10;───────────────────────&#10;PostgresDocumentRepository&#10;   - add(), get_by_id(), get_all()&#10;   - get_by_owner(), get_public()&#10;   - get_by_hash_and_owner() (dedup)&#10;   - update(), delete()&#10;MemoryDocumentRepository (Dev/Test)&#10;Schema: documents + document_chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="layer-be">

          <mxGeometry x="1650" y="1550" width="400" height="220" as="geometry" />

        </mxCell>

        <mxCell id="use-doc" value="useDocuments Hook (useDocuments.ts)&#10;────────────────────────&#10;Returns DocumentContext value&#10;Throws if used outside Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">

<mxGeometry x="580" y="980" width="300" height="80" as="geometry" />

        </mxCell>



        <mxCell id="db-schema" value="DATABASE SCHEMA (PostgreSQL + pgvector)&#10;───────────────────────&#10;documents table:&#10;  id UUID PK, name, size, file_hash,&#10;  storage_key, uploaded_at, status,&#10;  progress, chunk_count, owner_id,&#10;  uploader_email, uploader_name,&#10;  visibility (PRIVATE/PUBLIC)&#10;document_chunks table:&#10;  id UUID PK, document_id FK,&#10;  chunk_index, text, token_count,&#10;  metadata JSONB, embedding vector(384)&#10;Indexes:&#10;  HNSW on embedding (cosine_ops)&#10;  Unique(document_id, chunk_index)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=11;fontColor=#2E7D32;" vertex="1" parent="layer-be">

          <mxGeometry x="1650" y="1800" width="450" height="280" as="geometry" />

        </mxCell>



        <mxCell id="qa-svc" value="QuestionAnsweringService&#10;───────────────────────&#10;answer(query, limit, doc_id, user_id, is_admin)&#10;   1. RetrievalService.search()&#10;   2. Reranking (CrossEncoder)&#10;   3. LLM Generation (Ollama/OpenAI)&#10;   4. Citation Extraction&#10;Filters by visibility + ownership" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="1150" y="2050" width="450" height="180" as="geometry" />

        </mxCell>



        <mxCell id="retrieval-svc" value="RetrievalService&#10;───────────────────────&#10;search(query, limit, user_id, is_admin)&#10;   - Embed query → VectorStore.search()&#10;   - Filters: user_id + PUBLIC + is_admin&#10;   - Returns RetrievedChunk list&#10;candidate_limit → rerank → limit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" vertex="1" parent="layer-be">

          <mxGeometry x="1150" y="2250" width="450" height="150" as="geometry" />

        </mxCell>



        <mxCell id="settings" value="SETTINGS &amp; CONFIGURATION&#10;───────────────────────&#10;YAML Configs (app/config/):&#10;  document.yaml (upload, chunking, duplicate)&#10;  storage.yaml (provider, path)&#10;  chunking.yaml (strategy, size, overlap)&#10;  embedding.yaml (provider, model)&#10;  vector_store.yaml (provider, db_url)&#10;  retrieval.yaml (limits, threshold)&#10;  reranking.yaml (enabled, model)&#10;  llm.yaml (provider, model, temp)&#10;Env Overrides via .env / Docker Compose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#6C757D;fontSize=11;fontColor=#495057;" vertex="1" parent="layer-be">

