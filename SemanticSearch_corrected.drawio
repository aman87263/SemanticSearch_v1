        <mxCell id="routing" value="APP ROUTING (react-router-dom v6)&#10;BrowserRouter&#10;Routes:&#10;  /login → LoginPage&#10;  /login/callback → LoginCallbackPage&#10;  /chat → ChatPage (Protected)&#10;  /documents → DocumentsPage (Protected)&#10;  /search → SearchPage (Protected)&#10;  /settings → SettingsPage (Protected)&#10;  \* → Redirect to /chat&#10;ProtectedRoute wrapper with AuthContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#9C27B0;fontSize=11;fontColor=#7B1FA2;" vertex="1" parent="layer-fe">

