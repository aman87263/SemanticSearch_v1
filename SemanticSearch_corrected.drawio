                <mxCell id="edge-docctx-usedoc" edge="1" parent="1" source="doc-ctx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#43A047;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" target="use-doc" value="document state">
