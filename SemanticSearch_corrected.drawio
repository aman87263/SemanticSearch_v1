                <mxCell id="http-client" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" value="apiRequest / httpClient.ts&#xa;───────────────────────&#xa;Base URL: /api (proxied by Vite)&#xa;credentials: &#39;include&#39; (cookies)&#xa;Headers: Origin, Referer, Content-Type&#xa;Auto JSON parsing&#xa;Error handling &amp; parsing" vertex="1">
                    <mxGeometry height="140" width="400" x="900" y="880" as="geometry"/>
                </mxCell>
                <mxCell id="vite-proxy" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#AB47BC;fontSize=11;fontColor=#7B1FA2;" value="VITE DEV PROXY (vite.config.ts)&#xa;───────────────────────&#xa;/api → http\://localhost:8000&#xa;changeOrigin: true&#xa;Same-Origin for Cookies&#xa;HMR on Port 5173" vertex="1">
                    <mxGeometry height="140" width="350" x="1350" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="ui-components" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#9C27B0;fontSize=11;fontColor=#7B1FA2;" value="UI COMPONENTS (MUI v5)&#xa;───────────────────────&#xa;Layout:&#xa;  Sidebar (Auth, Navigation, User Info)&#xa;  MainLayout (Header + Content)&#xa;Pages:&#xa;  LoginPage / LoginCallbackPage&#xa;  ChatPage (ChatInterface + Citations)&#xa;  DocumentsPage (UploadZone + DocumentTable)&#xa;  SearchPage / SettingsPage&#xa;Components:&#xa;  UploadZone (Drag&amp;Drop, Visibility Toggle)&#xa;  DocumentTable + DocumentRow (Visibility Badge)&#xa;  StatusChip, DocumentRow, CitationChip" vertex="1">
                    <mxGeometry height="300" width="450" x="1350" y="620" as="geometry"/>
                </mxCell>
                <mxCell id="doc-ctx" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" value="DocumentContext (DocumentContext.tsx)&#xa;────────────────────────&#xa;State:&#xa;  documents: Document[]&#xa;  loading: boolean&#xa;Functions:&#xa;  uploadDocument(file, visibility)&#xa;  deleteDocument(id)&#xa;  updateDocumentVisibility(id, vis)&#xa;  refreshDocuments()&#xa;Auto-refresh on auth change&#xa;Optimistic Updates for all mutations" vertex="1">
                    <mxGeometry height="200" width="450" x="100" y="920" as="geometry"/>
                </mxCell>
                <mxCell id="use-doc" parent="layer-fe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#7B1FA2;fontSize=11;fontColor=#7B1FA2;" value="useDocuments Hook (useDocuments.ts)&#xa;────────────────────────&#xa;Returns DocumentContext value&#xa;Throws if used outside Provider" vertex="1">
                    <mxGeometry height="80" width="300" x="580" y="980" as="geometry"/>
                </mxCell>
                <mxCell id="layer-be" parent="1" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=10;fillColor=#E3F2FD;strokeColor=#2196F3;fontSize=14;fontColor=#1565C0;" value="BACKEND LAYER (FastAPI + Python 3.12 + Uvicorn + debugpy)" vertex="1">
                    <mxGeometry height="3460" width="2300" x="30" y="1520" as="geometry"/>
                </mxCell>
                <mxCell id="main-app" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="main.py (FastAPI App)&#xa;───────────────────────&#xa;Middleware Stack:&#xa;  1. CORSMiddleware&#xa;  2. SessionValidationMiddleware&#xa;  3. CSRFProtectionMiddleware&#xa;Routers:&#xa;  /api/auth → Auth Router&#xa;  /api/documents → Document Router&#xa;  /api/chat → Chat Router&#xa;  /api/search → Search Router&#xa;  /api/health → Health Check&#xa;Debug: debugpy on Port 5678" vertex="1">
                    <mxGeometry height="220" width="2300" y="30" as="geometry"/>
                </mxCell>
                <mxCell id="middleware" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="MIDDLEWARE STACK&#xa;───────────────────────&#xa;1. SessionValidationMiddleware&#xa;   - Skip: /auth/\*, /api/health, /api/auth/refresh&#xa;   - Reads HttpOnly Cookie (semanticsearch_session)&#xa;   - Validates session in SESSION_STORE&#xa;   - Attaches session to request.state&#xa;2. CSRFProtectionMiddleware&#xa;   - POST/PUT/PATCH/DELETE&#xa;   - Validates Origin/Referer headers&#xa;   - Allowed: localhost:5173, localhost:8080" vertex="1">
                    <mxGeometry height="200" width="2300" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="auth-router" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="Auth Router (auth.py)&#xa;───────────────────────&#xa;POST /api/auth/session&#xa;   - Dev: Creates session from code/verifier&#xa;   - Prod: Exchanges code with Keycloak&#xa;   - Stores refresh_token in SESSION_STORE&#xa;   - Sets HttpOnly Cookie + returns access_token&#xa;POST /api/auth/refresh&#xa;   - Uses Cookie to find session&#xa;   - Exchanges refresh_token with Keycloak&#xa;   - Returns new access_token&#xa;   - Mutex lock per session_id (prevents race)&#xa;POST /api/auth/logout&#xa;   - Revokes session, deletes cookie&#xa;GET /api/auth/me&#xa;   - Returns user info from JWT&#xa;GET /api/auth/keycloak/config&#xa;   - Returns Keycloak client config" vertex="1">
                    <mxGeometry height="280" width="2300" y="450" as="geometry"/>
                </mxCell>
                <mxCell id="doc-router" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="Document Router (document.py)&#xa;───────────────────────&#xa;GET /api/documents&#xa;   - Returns user&#39;s docs + public docs&#xa;GET /api/documents/public&#xa;   - Returns all PUBLIC docs (no auth)&#xa;POST /api/documents&#xa;   - Upload with visibility (PRIVATE/PUBLIC)&#xa;   - FormData: file + visibility&#xa;PATCH /api/documents/{id}/visibility&#xa;   - Toggle PRIVATE ↔ PUBLIC (owner/admin)&#xa;DELETE /api/documents/{id}&#xa;   - Owner or Admin only (403 if not)" vertex="1">
                    <mxGeometry height="280" width="2300" y="730" as="geometry"/>
                </mxCell>
                <mxCell id="chat-router" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="Chat &amp; Search Routers&#xa;───────────────────────&#xa;POST /api/chat&#xa;   - QuestionRequest {query, limit, doc_id}&#xa;   - Optional auth (get_current_user_optional)&#xa;   - Filters: owner_id + PUBLIC docs&#xa;POST /api/search&#xa;   - SearchRequest {query, limit, doc_id}&#xa;   - Vector similarity search&#xa;   - Filters by visibility + ownership" vertex="1">
                    <mxGeometry height="200" width="2300" y="1010" as="geometry"/>
                </mxCell>
                <mxCell id="auth-deps" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="Auth Dependencies (dependencies/auth.py)&#xa;───────────────────────&#xa;get_current_user() → CurrentUser&#xa;   - Extracts Bearer token&#xa;   - Validates JWT via Keycloak JWKS&#xa;   - Returns CurrentUser (user_id, roles, email, etc.)&#xa;get_current_user_optional() → CurrentUser | None&#xa;   - Returns unauthenticated user if no token&#xa;require_authenticated_user() → CurrentUser&#xa;   - Raises 401 if not authenticated&#xa;require_admin() → CurrentUser&#xa;   - Raises 403 if not ADMIN role&#xa;get_session_from_cookie() → Session&#xa;   - Reads HttpOnly Cookie&#xa;   - Validates against SESSION_STORE" vertex="1">
                    <mxGeometry height="240" width="2300" y="1210" as="geometry"/>
                </mxCell>
                <mxCell id="session-store" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontSize=11;fontColor=#E65100;" value="SESSION_STORE (In-Memory Dict)&#xa;──────────────────────&#xa;Key: session_id (UUID)&#xa;Value: Session{&#xa;  user_id, roles, provider,&#xa;  refresh_token, created_at,&#xa;  revoked: bool&#xa;}&#xa;Mutex: \_refresh_locks dict per session&#xa;⚠️ Dev only - Use Redis in Production" vertex="1">
                    <mxGeometry height="200" width="2300" y="1450" as="geometry"/>
                </mxCell>
                <mxCell id="doc-svc-be" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="DocumentService (document_service.py)&#xa;────────────────────────&#xa;upload_document()&#xa;   - Validate file (ext, size)&#xa;   - Hash (SHA256) + Duplicate Check (per-user)&#xa;   - Store file → Create Document Entity&#xa;   - Processing Pipeline → Chunk + Embed&#xa;   - Upsert to Vector Store&#xa;get_documents(user_id, is_admin)&#xa;   - Admin: all docs&#xa;   - User: own + public&#xa;   - Anonymous: public only&#xa;update_document_visibility()&#xa;   - Owner/Admin only&#xa;delete_document()&#xa;   - Delete file + chunks + vector embeddings" vertex="1">
                    <mxGeometry height="300" width="2300" y="1650" as="geometry"/>
                </mxCell>
                <mxCell id="pipeline" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="DocumentProcessingPipeline&#xa;───────────────────────&#xa;1. Text Extraction (PyMuPDF, python-docx)&#xa;2. Chunking (RecursiveChunker)&#xa;   - chunk_size=1000, overlap=200&#xa;3. Embedding (SentenceTransformers)&#xa;   - all-MiniLM-L6-v2 (384 dim)&#xa;4. Vector Store Upsert (pgvector)&#xa;Status Tracking: UPLOADING→PROCESSING→COMPLETED/FAILED" vertex="1">
                    <mxGeometry height="200" width="2300" y="1950" as="geometry"/>
                </mxCell>
                <mxCell id="vector-store" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=11;fontColor=#2E7D32;" value="Vector Store (pgvector via PgVectorStore)&#xa;───────────────────────&#xa;Interface: IVectorStore&#xa;upsert(chunks) → INSERT ON CONFLICT&#xa;search(query_vector, limit, filters)&#xa;   - HNSW Index (cosine similarity)&#xa;   - Filters: document_id, user_id, is_admin&#xa;   - PUBLIC docs visible to all&#xa;   - Private docs: owner_id filter&#xa;Table: document_chunks (embedding vector(384))" vertex="1">
                    <mxGeometry height="220" width="2300" y="2150" as="geometry"/>
                </mxCell>
                <mxCell id="repos" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=11;fontColor=#2E7D32;" value="REPOSITORY LAYER (IDocumentRepository)&#xa;───────────────────────&#xa;PostgresDocumentRepository&#xa;   - add(), get_by_id(), get_all()&#xa;   - get_by_owner(), get_public()&#xa;   - get_by_hash_and_owner() (dedup)&#xa;   - update(), delete()&#xa;MemoryDocumentRepository (Dev/Test)&#xa;Schema: documents + document_chunks" vertex="1">
                    <mxGeometry height="220" width="2300" y="2370" as="geometry"/>
                </mxCell>
                <mxCell id="db-schema" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#4CAF50;fontSize=11;fontColor=#2E7D32;" value="DATABASE SCHEMA (PostgreSQL + pgvector)&#xa;───────────────────────&#xa;documents table:&#xa;  id UUID PK, name, size, file_hash,&#xa;  storage_key, uploaded_at, status,&#xa;  progress, chunk_count, owner_id,&#xa;  uploader_email, uploader_name,&#xa;  visibility (PRIVATE/PUBLIC)&#xa;document_chunks table:&#xa;  id UUID PK, document_id FK,&#xa;  chunk_index, text, token_count,&#xa;  metadata JSONB, embedding vector(384)&#xa;Indexes:&#xa;  HNSW on embedding (cosine_ops)&#xa;  Unique(document_id, chunk_index)" vertex="1">
                    <mxGeometry height="280" width="2300" y="2590" as="geometry"/>
                </mxCell>
                <mxCell id="qa-svc" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="QuestionAnsweringService&#xa;───────────────────────&#xa;answer(query, limit, doc_id, user_id, is_admin)&#xa;   1. RetrievalService.search()&#xa;   2. Reranking (CrossEncoder)&#xa;   3. LLM Generation (Ollama/OpenAI)&#xa;   4. Citation Extraction&#xa;Filters by visibility + ownership" vertex="1">
                    <mxGeometry height="180" width="2300" y="2870" as="geometry"/>
                </mxCell>
                <mxCell id="retrieval-svc" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#2196F3;fontSize=11;fontColor=#1565C0;" value="RetrievalService&#xa;───────────────────────&#xa;search(query, limit, user_id, is_admin)&#xa;   - Embed query → VectorStore.search()&#xa;   - Filters: user_id + PUBLIC + is_admin&#xa;   - Returns RetrievedChunk list&#xa;candidate_limit → rerank → limit" vertex="1">
                    <mxGeometry height="150" width="2300" y="3050" as="geometry"/>
                </mxCell>
                <mxCell id="settings" parent="layer-be" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#6C757D;fontSize=11;fontColor=#495057;" value="SETTINGS &amp; CONFIGURATION&#xa;───────────────────────&#xa;YAML Configs (app/config/):&#xa;  document.yaml (upload, chunking, duplicate)&#xa;  storage.yaml (provider, path)&#xa;  chunking.yaml (strategy, size, overlap)&#xa;  embedding.yaml (provider, model)&#xa;  vector_store.yaml (provider, db_url)&#xa;  retrieval.yaml (limits, threshold)&#xa;  reranking.yaml (enabled, model)&#xa;  llm.yaml (provider, model, temp)&#xa;Env Overrides via .env / Docker Compose" vertex="1">
                    <mxGeometry height="250" width="2300" y="3200" as="geometry"/>
                </mxCell>
