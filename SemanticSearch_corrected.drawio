        <mxCell id="layer-be" value="BACKEND LAYER (FastAPI + Python 3.12 + Uvicorn + debugpy)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=10;fillColor=#E3F2FD;strokeColor=#2196F3;fontSize=14;fontColor=#1565C0;" vertex="1" parent="1">

