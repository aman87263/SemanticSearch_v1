# Production Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_ENVIRONMENT=production

# Database (Supabase PostgreSQL with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=semanticsearch
DATABASE_URL=postgresql://postgres:your-secure-password@db.xxx.supabase.co:5432/postgres?sslmode=require

# Groq API Key
GROQ_API_KEY=your-groq-api-key

# Upload Directory
UPLOAD_DIRECTORY=/tmp/uploads

# CORS Origins (your frontend URL)
CORS_ORIGINS=https://yourdomain.com

# Frontend API Base URL
VITE_API_BASE_URL=https://yourdomain.com/api

# Keycloak Configuration
KC_HOSTNAME=yourdomain.com
KEYCLOAK_URL=https://yourdomain.com/auth
KEYCLOAK_REALM=semanticsearch
KEYCLOAK_CLIENT_ID=semanticsearch-web
KEYCLOAK_AUDIENCE=semanticsearch-web
KEYCLOAK_REDIRECT_URI=https://yourdomain.com/login/callback
KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://yourdomain.com/login
KEYCLOAK_SCOPE=openid profile email
KEYCLOAK_JWKS_TIMEOUT_SEC=5
KEYCLOAK_JWKS_VERIFY_ENABLED=true
KEYCLOAK_REFRESH_EXCHANGE_ENABLED=true

# Keycloak Admin Credentials
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your-secure-admin-password

# Session Configuration
SESSION_COOKIE_NAME=semanticsearch_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
SESSION_MAX_AGE_SECONDS=604800

# Redis (for session store)
REDIS_URL=redis://redis:6379

